{
  "name": "@air/dsh-voice-approval",
  "description": "Voice approval for sandbox escalations: default-deny, one spoken yes allows one exact command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./token": "./src/token.ts",
    "./denial": "./src/denial.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "src/token.ts",
    "src/denial.ts",
    "src/digest.ts",
    "src/summary.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "link:../../../vendor/schemastery"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.1 || ^0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../vendor/cordis",
    "@deepseek-ai/dsh-llm": "link:../../../packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../packages/core/session",
    "@deepseek-ai/dsh-subprocess-local": "link:../../../packages/subprocess/subprocess-local",
    "@deepseek-ai/dsh-system-prompt": "link:../../../packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../../../packages/core/tools",
    "@deepseek-ai/dsh-user-approval": "link:../../../packages/interaction/user-approval",
    "@deepseek-ai/dsh-agent": "link:../../../packages/core/agent"
  }
}
