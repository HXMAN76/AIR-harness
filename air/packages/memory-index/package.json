{
  "name": "@air/dsh-memory-index",
  "description": "AIR memory search: disposable SQLite FTS5 index over memory files, ranked by BM25",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@air/dsh-memory-store": "workspace:*",
    "@deepseek-ai/schemastery": "link:../../../vendor/schemastery"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1 || ^0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../vendor/cordis",
    "@deepseek-ai/dsh-home-paths": "link:../../../packages/util/home-paths"
  }
}
